# Server Configuration
SERVER_PORT=8080
COOKIE_SECURE=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dsip
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=5

# JPA Configuration
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Google OAuth2 Configuration (Required)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH2_REDIRECT_URI=http://localhost:8081/login/oauth2/code/google

# OAuth2 Redirect URLs
OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:3000
OAUTH2_FAILURE_REDIRECT_URL=http://localhost:3000/auth/error
OAUTH2_WHITELIST_FAILURE_REDIRECT_URL=http://localhost:3000/auth/unauthorized

# Session Configuration
SESSION_INACTIVITY_TIMEOUT_DAYS=7
SESSION_MAX_LIFETIME_DAYS=60
SESSION_MAX_AGE=5184000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging Configuration
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SESSION=INFO

# Stock API Configuration
# Finnhub API for US market stock prices (Get free API key at https://finnhub.io/)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Upstox API for Indian market stock prices (NSE/BSE)
# Get access token after OAuth authentication at https://api.upstox.com/
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here
